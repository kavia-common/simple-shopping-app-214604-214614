{
  "name": "tizen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "vite", 
    "dev:purge-cache": "node -e \"try{require('fs').rmSync('node_modules/.vite',{recursive:true,force:true});console.log('Purged node_modules/.vite cache')}catch(e){console.warn('No .vite cache to purge')}}\" && vite",
    "build": "vite build || node ./scripts/build-fallback.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:tizen": "vite build || node ./scripts/build-fallback.js",
    "package:tizen": "cd dist && zip -r ../app.wgt * ../config.xml",
    "postinstall": "node -e \"try{const p=require('./package.json');if(p.devDependencies&&p.devDependencies.vite){console.log('Using vite',p.devDependencies.vite)} }catch(e){process.exit(0)}\"",
    "prepare": "node -e \"const fs=require('fs');if(!fs.existsSync('npm-shrinkwrap.json')){console.warn('Warning: npm-shrinkwrap.json missing; installs may drift.') }}\""
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "8.57.0",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@vitejs/plugin-react": "3.1.0",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.7",
    "globals": "13.24.0",
    "vite": "4.5.3",
    "esbuild": "0.19.12"
  },
  "engines": {
    "node": ">=18 <20"
  },
  "overrides": {
    "vite": "4.5.3",
    "@vitejs/plugin-react": "3.1.0",
    "esbuild": "0.19.12"
  },
  "resolutions": {
    "vite": "4.5.3",
    "@vitejs/plugin-react": "3.1.0",
    "esbuild": "0.19.12"
  },
  "packageManager": "npm@10"
}
